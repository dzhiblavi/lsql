#include "util/build_info.h"

#include <magic_enum.hpp>

#include <format>

// clang-format off

#define LSQL_VERSION_MAJOR @CMAKE_PROJECT_VERSION_MAJOR@
#define LSQL_VERSION_MINOR @CMAKE_PROJECT_VERSION_MINOR@
#define LSQL_VERSION_PATCH @CMAKE_PROJECT_VERSION_PATCH@
#define LSQL_BUILD_TIMESTAMP "@LSQL_BUILD_TIMESTAMP@"
#define LSQL_GIT_SHA1 "@GIT_SHA1@"
#define LSQL_GIT_LOCAL_STATE "@GIT_LOCAL_STATE@"

// clang-format on

namespace lsql {

std::string_view getGitCommitSHA1() {
    return LSQL_GIT_SHA1;
}

bool isLocalStateClean() {
    return std::string(LSQL_GIT_LOCAL_STATE) == "CLEAN";
}

ProjectVersion getProjectVersion() {
    return {
        .major = LSQL_VERSION_MAJOR,
        .minor = LSQL_VERSION_MINOR,
        .patch = LSQL_VERSION_PATCH,
    };
}

std::string_view getBuildTimestamp() {
    return LSQL_BUILD_TIMESTAMP;
}

// clang-format on

std::string formatBuildInfo() {
    auto [ma, mi, pa] = getProjectVersion();

    return std::format(
        "v{}.{}.{}\ngit_sha: {}\ngit_state: {}\nbuilt_at: {}\nbuild_type: {}\nASAN: "
        "{}\nTSAN: {}\nUBSAN: {}",
        ma,
        mi,
        pa,
        getGitCommitSHA1(),
        isLocalStateClean() ? "clean" : "dirty",
        getBuildTimestamp(),
        magic_enum::enum_name(getBuildType()),
        magic_enum::enum_name(isBuiltWithASAN()),
        magic_enum::enum_name(isBuiltWithTSAN()),
        magic_enum::enum_name(isBuiltWithUBSAN()));
}

}  // namespace lsql
