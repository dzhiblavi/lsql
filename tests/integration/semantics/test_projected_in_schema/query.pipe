input = file input.1.txt
late_users = file input.1.txt
late_forwarded =
    $late_users
    | select *

ok_users =
    $input
    | where .status = 'ok'
    | select .uid

---------------------

$input
| select .uid, .uid in (
    $ok_users
) as is_ok
| where .uid != 'missing'
| sort by .uid

$input
| select .uid, .uid in (
    $late_forwarded
) as is_known, 1 as test_index
| sort by .uid

$late_forwarded
| select .uid, 2 as test_index
| sort by .uid
