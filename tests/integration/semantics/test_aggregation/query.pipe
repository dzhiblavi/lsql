input = file input.1.txt

---------------------

$input
| select
    count(*) as count,
    1 as test_index

$input
| select
    count(true) as count_true,
    count(false) as count_false,
    count(null) as count_null,
    2 as test_index

$input
| select
    min(.timestamp) as min_ts,
    max(.timestamp) as max_ts,
    3 as test_index

$input
| select
    min(.uid) as min_uid,
    max(.uid) as max_uid,
    4 as test_index

$input
| where .status = 'ok'
| select
    count(*) as count,
    min(.timestamp) as min_ts,
    max(.timestamp) as max_ts,
    5 as test_index
